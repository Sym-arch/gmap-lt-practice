# ===== Supabase（ログイン・購入記録） =====
# Supabaseダッシュボード → Project Settings → API からコピー
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー（絶対に公開しないこと。Vercelの環境変数にのみ設定）
SUPABASE_SERVICE_ROLE_KEY=

# ===== Stripe（決済） =====
# Stripeダッシュボード → 開発者 → APIキー
STRIPE_SECRET_KEY=
# Webhook署名シークレット（エンドポイント /api/stripe-webhook 作成時に発行される）
STRIPE_WEBHOOK_SECRET=

# ===== その他 =====
# 本番URL（例: https://gmap-lt-practice.vercel.app）
NEXT_PUBLIC_SITE_URL=
# カンマ区切りのメールアドレス。ここに載せたアカウントは購入なしで全問アクセス可（運営者用）
PREMIUM_EMAILS=
